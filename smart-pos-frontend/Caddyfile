:80 {
	encode gzip
	root * /srv/www

	handle /api/* {
		reverse_proxy backend:4000
	}

	handle /assets/* {
		header Cache-Control "public, max-age=2592000, immutable"
		file_server
	}

	# index.html must always be revalidated. The hashed asset filenames change
	# every build, so a cached index.html would keep pointing browsers at the
	# previous bundle — which /assets/* has told them to keep for 30 days —
	# and a deploy would silently never reach the user.
	handle {
		header Cache-Control "no-cache, must-revalidate"
		try_files {path} /index.html
		file_server
	}

	header X-Frame-Options "SAMEORIGIN"
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "no-referrer-when-downgrade"
}
