// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  password    String
  role        Role      @default(CASHIER)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  sales            Sale[]
  refunds          Refund[]
  debitNotes       DebitNote[]
  stockAdjustments StockAdjustment[]
  stockMovements   StockMovement[]
  shifts           Shift[]
  shiftCashMovements ShiftCashMovement[]
  discountApprovals Sale[] @relation("SaleDiscountApprovals")
  branchId         String?
  branch           Branch?   @relation(fields: [branchId], references: [code])

  // VSDC branch-user sync (Section 5.5, POST /branches/saveBrancheUser)
  zraSyncedAt      DateTime?
  zraSyncError     String?
  zraSyncResponse  Json?

  @@map("users")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  products    Product[]
  
  @@map("categories")
}

model Product {
  id                    String   @id @default(cuid())
  name                  String
  description           String?
  price                 Float
  cost                  Float?
  sku                   String?  @unique
  barcode               String?  @unique
  isActive              Boolean  @default(true)
  categoryId            String
  
  // Business Information
  brand                 String?
  unit                  String?  @default("EA") // EA, KG, L, etc.
  minPrice              Float?   // Minimum selling price
  maxDiscount           Float?   @default(0) // Maximum discount %
  
  // ZRA/VSDC specific fields for 100% compliance
  zraItemClassification String?  // ZRA item classification code  
  zraClassificationCode String?  // Alternative field name for classification
  zraPackageUnit        String?  // Package unit for ZRA (e.g., "EA", "KG")
  zraQuantityUnit       String?  // Quantity unit for ZRA  
  taxType               String?  // Tax type (A=Standard, B=Zero, C=Exempt, etc.)
  taxRate               Float    @default(16.0) // VAT rate
  vatCategoryCode       String?  @default("STANDARD") // STANDARD, EXEMPT, ZERO_RATED
  exciseTaxCode         String?  // Excise tax code if applicable
  
  // Expiry tracking fields
  hasExpiry             Boolean  @default(false)
  shelfLifeDays         Int?     // Shelf life in days
  
  // Inventory management
  minStockLevel         Int      @default(0)

  // VSDC item registration (Section 6.1)
  zraRegistrationStatus ZraRegistrationStatus @default(PENDING)
  zraRegisteredAt       DateTime?
  zraRegistrationError  String?
  vsdcItemResponse      Json?

  // Item 10* (POST /items/selectItems) retrieval — a read-only reconciliation
  // snapshot of what ZRA has on file for this itemCd, mirroring
  // Branch.zraBranchSnapshot: kept separate from the operational fields
  // above (name, price, barcode, etc.) rather than overwriting them, since
  // ZRA's copy is a reference to compare against, not an authority that
  // should silently mutate a live catalog record. Unlike item 28*'s stock
  // retrieval, this endpoint returns one row per itemCd (an item master
  // list, not an event log), so no separate idempotency key/dedup table is
  // needed — this column is simply overwritten on every sync.
  zraItemSnapshot       Json?
  zraSnapshotSyncedAt   DateTime?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // Relations
  category              Category     @relation(fields: [categoryId], references: [id])
  inventory             Inventory[]
  saleItems             SaleItem[]
  refundItems           RefundItem[]
  debitNoteItems        DebitNoteItem[]
  stockAdjustments      StockAdjustment[]
  stockMovements        StockMovement[]
  InventoryItem         InventoryBatch[] @relation("ProductBatches") // Use InventoryBatch for consistency
  purchaseOrderItems    PurchaseOrderItem[]
  goodsReceivedNoteItems GoodsReceivedNoteItem[]
  supplierReturnItems   SupplierReturnItem[]
  compositionsAsParent    ProductComposition[] @relation("CompositionParent")
  compositionsAsComponent ProductComposition[] @relation("CompositionComponent")

  @@map("products")
}

// VSDC Item Composition (Section 6.5, /items/saveItemComposition, OPTIONAL
// per spec) — a bill-of-materials line: `quantity` of `componentProduct` used
// per unit of `parentProduct`. One row per component; a finished product with
// several ingredients has several rows sharing the same parentProductId.
model ProductComposition {
  id                    String   @id @default(cuid())
  parentProductId       String
  componentProductId    String
  quantity              Float

  zraRegistrationStatus ZraRegistrationStatus @default(PENDING)
  zraRegisteredAt       DateTime?
  zraRegistrationError  String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  parentProduct    Product @relation("CompositionParent", fields: [parentProductId], references: [id])
  componentProduct Product @relation("CompositionComponent", fields: [componentProductId], references: [id])

  @@unique([parentProductId, componentProductId])
  @@map("product_compositions")
}

model Sale {
  id          String     @id @default(cuid())
  total       Float
  tax         Float?
  discount    Float?
  subtotal    Float
  status      SaleStatus @default(PENDING)
  paymentMethod PaymentMethod
  userId      String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  // ZRA Smart Invoice fields
  rcptNo         String?    // Receipt number from ZRA
  rcptSign       String?    // Digital signature (receiptSignature)
  intrlData      String?    // VSDC internal data — distinct from rcptSign, both required on the printed invoice
  qrCode         String?    // QR Code URL
  vsdcTimestamp  DateTime?  // Timestamp ZRA issued invoice
  vsdcRequest    Json?      // VSDC request payload (retention)
  vsdcResponse   Json?      // VSDC response payload (retention)
  fiscalError    String?    // Last fiscal submission error
  fiscalErrorCode String?   // ZRA resultCd from the failed submission (e.g. "007" = duplicate), distinct from the human message
  fiscalInvcNo   Int?       // Sequential VSDC invoice number (per device)
  vsdcRcptPbctDate DateTime? // VSDC-issued confirmation date (distinct from vsdcTimestamp, our local clock)
  branchId       String     @default("main") // Operational branch code (inventory.branchId)

  // Receipt / customer
  customerName   String?
  customerTpin   String?
  amountPaid     Float?
  changeAmount   Float?
  
  // Cash register attribution — the shift open when this sale was created, if any.
  shiftId        String?

  // Manager sign-off recorded when a line or order discount exceeded the
  // approval threshold (Product.maxDiscount, or the default policy floor).
  discountApprovedByUserId String?

  // Registered customer attached at checkout, if any (walk-in sales leave this null).
  customerId String?

  // Relations
  user        User       @relation(fields: [userId], references: [id])
  branch      Branch     @relation(fields: [branchId], references: [code])
  saleItems   SaleItem[]
  refunds     Refund[]   @relation("SaleRefunds")
  debitNotes  DebitNote[]
  shift       Shift?     @relation(fields: [shiftId], references: [id])
  discountApprovedBy User? @relation("SaleDiscountApprovals", fields: [discountApprovedByUserId], references: [id])
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([shiftId])
  @@index([discountApprovedByUserId])
  @@index([customerId])
  // Regression guard on the atomic counter in allocateFiscalInvcNo — does not
  // catch a sale and a refund colliding, since they share one counter across
  // two tables (see fiscalInvoiceNumber.js).
  @@unique([fiscalInvcNo])
  @@map("sales")
}

model Refund {
  id             String       @id @default(cuid())
  originalSaleId String
  userId         String
  status         RefundStatus @default(PENDING)
  reasonCode     String       @default("01")
  reason         String?
  subtotal       Float
  tax            Float?
  discount       Float?
  total          Float
  paymentMethod  PaymentMethod

  rcptNo         String?
  rcptSign       String?
  intrlData      String?
  qrCode         String?
  vsdcTimestamp  DateTime?
  vsdcRequest    Json?
  vsdcResponse   Json?
  fiscalError    String?
  fiscalErrorCode String?
  vsdcRcptPbctDate DateTime? // VSDC-issued confirmation date (distinct from vsdcTimestamp, our local clock)

  fiscalInvcNo   Int?       // Sequential VSDC credit-note invoice number

  // Cash register attribution — the shift open when this refund was created, if any.
  shiftId        String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  originalSale   Sale         @relation("SaleRefunds", fields: [originalSaleId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  refundItems    RefundItem[]
  shift          Shift?       @relation(fields: [shiftId], references: [id])

  @@index([originalSaleId])
  @@index([shiftId])
  @@unique([fiscalInvcNo])
  @@map("refunds")
}

model RefundItem {
  id         String  @id @default(cuid())
  refundId   String
  saleItemId String?
  productId  String
  quantity   Int
  price      Float
  total      Float
  pkg        Int?
  qty        Int
  prc        Float
  splyAmt    Float
  taxblAmt   Float
  taxAmt     Float
  totAmt     Float

  // Snapshot of the product's ZRA classification/tax type at refund time —
  // a later edit to Product must not change what a past credit note (re)submits
  // or reprints (see the equivalent SaleItem fields and saleFiscal.js note).
  itemClsCd  String?
  taxType    String?

  refund     Refund  @relation(fields: [refundId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])

  @@map("refund_items")
}

model DebitNote {
  id             String       @id @default(cuid())
  originalSaleId String
  userId         String
  status         RefundStatus @default(PENDING)
  reasonCode     String       @default("01")
  reason         String?
  subtotal       Float
  tax            Float?
  discount       Float?
  total          Float
  paymentMethod  PaymentMethod

  rcptNo         String?
  rcptSign       String?
  intrlData      String?
  qrCode         String?
  vsdcTimestamp  DateTime?
  vsdcRcptPbctDate DateTime?
  vsdcRequest    Json?
  vsdcResponse   Json?
  fiscalError    String?
  fiscalErrorCode String?
  fiscalInvcNo   Int?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items          DebitNoteItem[]
  sale           Sale         @relation(fields: [originalSaleId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@map("debit_notes")
}

model DebitNoteItem {
  id           String  @id @default(cuid())
  debitNoteId  String
  saleItemId   String?
  productId    String
  quantity     Int
  price        Float
  total        Float
  pkg          Int?
  qty          Int
  prc          Float
  splyAmt      Float
  taxblAmt     Float
  taxAmt       Float
  totAmt       Float

  itemClsCd    String?
  taxType      String?

  debitNote    DebitNote @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId], references: [id])

  @@map("debit_note_items")
}

model SaleItem {
  id        String  @id @default(cuid())
  quantity  Int
  price     Float
  total     Float
  saleId    String
  productId String

  // Line-item discount amount — informational/audit only. Folded into the
  // order-level Sale.discount for fiscal total math (see lib/saleFiscal.js);
  // does not alter this line's own tax calculation, so it doesn't touch the
  // existing splyAmt/taxblAmt/taxAmt/totAmt contract refunds/VSDC rely on.
  discount  Float   @default(0)


  // VSDC Required fields for 100% compliance
  pkg       Int?     // Package Quantity - ZRA requirement
  qty       Int      // Quantity (same as quantity but ZRA specific)
  prc       Float    // Unit Price - ZRA format
  splyAmt   Float    // Supply Amount
  taxblAmt  Float    // Taxable Amount
  taxAmt    Float    // Tax Amount
  totAmt    Float    // Total Amount per item

  // Snapshot of the product's ZRA item classification and tax type at sale
  // time. Read live from Product at VSDC-submission time until this was added,
  // which meant a later edit to a product's classification silently changed
  // what an already-fiscalized (but retried) or reprinted sale would submit/
  // show. Falls back to a live Product read for rows created before this field
  // existed (see services/zraInvoice.js).
  itemClsCd String?
  taxType   String?

  // Relations
  sale      Sale    @relation(fields: [saleId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
  
  @@map("sale_items")
}

// ZRA Invoice tracking model for full compliance
model Invoice {
  id                String    @id @default(cuid())
  invoiceNumber     String    @unique
  customerName      String
  customerTpin      String?
  totalAmount       Float
  totalTaxAmount    Float
  salesDate         DateTime
  
  // ZRA VSDC Response Fields
  zraInvcSdcId      String?   // ZRA Invoice SDC ID
  zraRcptNo         String?   // ZRA Receipt Number
  zraQrCode         String?   // ZRA QR Code
  zraSdcId          String?   // ZRA SDC ID
  zraMrcNo          String?   // ZRA MRC Number
  zraSubmittedAt    DateTime? // When submitted to ZRA
  
  // Status tracking
  submissionStatus  InvoiceStatus @default(PENDING)
  retryCount        Int       @default(0)
  lastError         String?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@map("invoices")
}

// Stock Adjustment model for ZRA compliance
model StockAdjustment {
  id          String            @id @default(cuid())
  productId   String
  adjustmentType StockAdjustmentType
  quantity    Int
  reason      String
  ocrnDt      DateTime          // Occurrence Date - ZRA requirement
  userId      String
  
  // Relations
  product     Product @relation(fields: [productId], references: [id])
  user        User    @relation(fields: [userId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("stock_adjustments")
}

// Inventory model for tracking stock levels per product per location
model Inventory {
  id                String    @id @default(cuid())
  productId         String
  branchId          String    @default("main") // Support for multiple locations
  
  // Stock Information
  currentStock      Int       @default(0)
  reservedStock     Int       @default(0) // Held during FISCAL_SUBMITTING (pre-deduct)
  minimumStock      Int       @default(0)
  maximumStock      Int       @default(1000)
  reorderPoint      Int       @default(10)
  reorderQuantity   Int       @default(50)
  
  // Cost Information
  averageCost       Float     @default(0)
  lastCost          Float     @default(0)
  totalValue        Float     @default(0) // currentStock * averageCost
  
  // Tracking Information
  lastStockedDate   DateTime?
  lastSoldDate      DateTime?
  lastCountDate     DateTime? // Last physical count
  
  // Alerts
  lowStockAlert     Boolean   @default(false)
  excessStockAlert  Boolean   @default(false)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relations
  product           Product   @relation(fields: [productId], references: [id])
  batches           InventoryBatch[]
  
  // Ensure one inventory record per product per branch
  @@unique([productId, branchId])
  @@map("inventory")
}

// New model for batch-level tracking with expiry dates
model InventoryBatch {
  id                String    @id @default(cuid())
  inventoryId       String?
  productId         String    // Direct product relation for easier queries
  batchNumber       String?
  quantity          Int
  unitCost          Float
  totalCost         Float
  costPrice         Float    // Alias for unitCost for consistency with frontend
  sellingPrice      Float    // Current selling price for this batch
  supplier          String?  // Supplier name/info
  
  // Expiry tracking
  receivedDate      DateTime  @default(now())
  expiryDate        DateTime?
  daysUntilExpiry   Int?      // Calculated field
  
  // Supplier information
  supplierInfo      String?
  supplierBatch     String?
  
  // Status tracking
  status            BatchStatus @default(ACTIVE)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Optional link to a real Supplier record — the pre-existing `supplier`/
  // `supplierInfo` free-text fields above stay untouched for the legacy
  // receiving path; this is additive, populated only via GRN receiving.
  supplierId        String?

  // Relations
  inventory         Inventory? @relation(fields: [inventoryId], references: [id])
  product           Product    @relation("ProductBatches", fields: [productId], references: [id])
  movements         StockMovement[]
  supplierRecord    Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  grnItems          GoodsReceivedNoteItem[]
  supplierReturnItems SupplierReturnItem[]

  @@index([supplierId])
  @@map("inventory_batches")
}

// Stock Movement model for tracking all inventory changes
model StockMovement {
  id                String              @id @default(cuid())
  productId         String
  branchId          String              @default("main")
  batchId           String?             // Link to specific batch
  
  // Movement Details
  movementType      StockMovementType
  quantity          Int                 // Positive for inbound, negative for outbound
  previousStock     Int
  newStock          Int
  unitCost          Float?
  totalCost         Float?
  
  // Reference Information
  referenceType     String?             // SALE, PURCHASE, ADJUSTMENT, TRANSFER
  referenceId       String?             // ID of the related transaction
  reason            String?
  notes             String?
  
  // Batch/Lot Information (for advanced inventory)
  batchNumber       String?
  expiryDate        DateTime?
  supplierInfo      String?
  
  // User Information
  // Nullable as of item 28* (2026-08-12) — a record retrieved from ZRA via
  // selectStockItems has no local SmartPOS operator to attribute it to.
  // Every locally-originated movement (sale/adjustment/etc.) still sets
  // this; only RECONCILED rows leave it null.
  userId            String?

  // VSDC stock sync (Section 6.2)
  zraSyncedAt       DateTime?
  zraSyncError      String?
  zraSyncResponse   Json?

  createdAt         DateTime            @default(now())

  // Relations
  // Relations
  product           Product             @relation(fields: [productId], references: [id])
  user              User?               @relation(fields: [userId], references: [id])
  batch             InventoryBatch?     @relation(fields: [batchId], references: [id])

  @@map("stock_movements")
}

// Item 28* (POST /stock/selectStockItems) sync cursor — one row per branch.
// Deliberately its own small model, not a new StockMovement field: this is
// bookkeeping for the retrieval PROCESS (what lastReqDt to send next, did
// the last run succeed), not stock data itself, and needs to persist
// across restarts (an in-memory cursor, like zraCodesService.js's
// lastSyncDate, would silently reset to a stale default on every deploy).
model StockRetrievalCursor {
  id                String   @id @default(cuid())
  branchId          String   @unique
  lastReqDt         String   // yyyyMMddHHmmss sent on the most recent successful call
  lastSyncedAt      DateTime?
  lastSyncError     String?
  lastImportedCount Int      @default(0)
  updatedAt         DateTime @updatedAt

  @@map("stock_retrieval_cursors")
}

// Item 10* (POST /items/selectItems) sync cursor — one row per branch,
// structurally identical to StockRetrievalCursor and kept as its own model
// for the same reason: this is bookkeeping for the retrieval PROCESS (what
// lastReqDt to send next, did the last run succeed), not item data itself,
// and needs to persist across restarts.
model ItemRetrievalCursor {
  id                String    @id @default(cuid())
  branchId          String    @unique
  lastReqDt         String    // yyyyMMddHHmmss sent on the most recent successful call
  lastSyncedAt      DateTime?
  lastSyncError     String?
  lastImportedCount Int       @default(0)
  updatedAt         DateTime  @updatedAt

  @@map("item_retrieval_cursors")
}

// Business branch (VSDC Section 7.1) — code matches inventory.branchId / sale.branchId
model Branch {
  id                    String    @id @default(cuid())
  code                  String    @unique
  bhfId                 String    @unique
  name                  String
  address               String
  phone                 String?
  email                 String?
  managerName           String?
  managerPhone          String?
  province              String?
  district              String?
  isActive              Boolean   @default(true)
  zraRegistered         Boolean   @default(false)
  zraRegistrationDate   DateTime?
  zraRegistrationNumber String?

  // VSDC branch retrieval (Section 5.5, POST /branches/selectBranches) — a
  // read-verification snapshot of what ZRA has on file for this bhfId, kept
  // separate from the operational name/province/district/etc. above rather
  // than overwriting them: those fields are foreign-key-critical locally
  // (sales.branchId, shifts, etc.) and ZRA's copy is a reference to compare
  // against, not an authority that should silently mutate live records.
  zraBranchSnapshot     Json?
  zraSnapshotSyncedAt   DateTime?

  createdBy             String?
  updatedBy             String?
  deactivatedAt         DateTime?
  deactivatedBy         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  users                 User[]
  sales                 Sale[]
  shifts                Shift[]
  purchaseOrders        PurchaseOrder[]
  goodsReceivedNotes    GoodsReceivedNote[]
  supplierReturns       SupplierReturn[]

  @@map("branches")
}

// Cash register / till session — the "trust boundary" for a cashier's cash
// drawer over a shift: opening float, cash movements, and a final count
// reconciled against what sales/refunds during the shift say should be there.
model Shift {
  id             String      @id @default(cuid())
  shiftNumber    String      @unique // human-readable reference on X/Z reports
  branchId       String      @default("main")
  userId         String      // cashier who opened the shift
  status         ShiftStatus @default(OPEN)

  openingFloat   Float       @default(0)
  openedAt       DateTime    @default(now())
  openingNotes   String?

  closedAt       DateTime?
  closedByUserId String?
  countedCash    Float?      // physical cash counted at close
  expectedCash   Float?      // computed at close: float + cash sales - cash refunds + cashIn - cashOut - paidOut
  variance       Float?      // countedCash - expectedCash (negative = short, positive = over)
  closingNotes   String?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User                @relation(fields: [userId], references: [id])
  branch         Branch              @relation(fields: [branchId], references: [code])
  cashMovements  ShiftCashMovement[]
  sales          Sale[]
  refunds        Refund[]

  @@index([branchId, status])
  @@index([userId, status])
  @@map("shifts")
}

// Cash in / cash out / paid out entries recorded against an open shift —
// the audit trail behind a Z-report's expected-cash figure.
model ShiftCashMovement {
  id        String            @id @default(cuid())
  shiftId   String
  type      CashMovementType
  amount    Float
  reason    String?
  userId    String            // who recorded the movement (may differ from shift owner)
  createdAt DateTime          @default(now())

  shift     Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user      User  @relation(fields: [userId], references: [id])

  @@index([shiftId])
  @@map("shift_cash_movements")
}

model VsdcDevice {
  id           String   @id @default(cuid())
  tpin         String
  bhfId        String
  dvcSrlNo     String
  sdicId       String?
  mrcNo        String?
  intrlKey     String?
  signKey      String?
  cmcKey       String?
  initialized  Boolean  @default(false)
  lastInvcNo   Int      @default(0)  // Last allocated fiscal invoice number
  initResponse Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tpin, bhfId, dvcSrlNo])
  @@map("vsdc_devices")
}

model BusinessProfile {
  id              String   @id @default("default")
  tradingName     String
  tpin            String
  logoUrl         String?
  footerLines     Json     @default("[]")
  showPoweredBy   Boolean  @default(true)
  receiptVersion  String   @default("1.0")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("business_profiles")
}

model ReceiptSnapshot {
  id            String             @id @default(cuid())
  sourceType    ReceiptSourceType
  sourceId      String
  version       String             @default("1.0")
  snapshot      Json
  reprintCount  Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([sourceType, sourceId])
  @@map("receipt_snapshots")
}

// Tamper-evident audit trail for ZRA compliance (5-year retention requirement).
// Written by services/auditService.js; queried via routes/audit.js.
model AuditLog {
  id           String         @id
  eventType    String
  timestamp    DateTime       @default(now())
  userId       String?
  userRole     String?
  ipAddress    String?
  userAgent    String?
  sessionId    String?
  entityType   String?
  entityId     String?
  action       String?
  oldValues    Json?
  newValues    Json?
  description  String?
  riskLevel    AuditRiskLevel @default(LOW)
  success      Boolean        @default(true)
  errorMessage String?
  metadata     Json?
  hash         String
  createdAt    DateTime       @default(now())

  @@index([timestamp])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([eventType])
  @@index([riskLevel])
  @@map("audit_logs")
}

enum ReceiptSourceType {
  SALE
  CREDIT_NOTE
  DEBIT_NOTE
}

enum AuditRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PrinterType {
  BROWSER
  ESCPOS_NETWORK
}

model PrinterProfile {
  id        String      @id @default(cuid())
  name      String
  type      PrinterType @default(BROWSER)
  format    String      @default("thermal")
  host      String?
  port      Int         @default(9100)
  isDefault Boolean     @default(false)
  branchId  String?
  lastTestAt     DateTime?
  lastTestOk     Boolean?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("printer_profiles")
}

model ZraCode {
  id          String   @id @default(cuid())
  codeClass   String
  code        String
  name        String
  description String?
  rate        Float?
  raw         Json?
  syncedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([codeClass, code])
  @@map("zra_codes")
}

model ZraClassificationCode {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  level     Int?
  taxTyCd   String?
  mjrTgYn   String?
  useYn     String?
  raw       Json?
  syncedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("zra_classification_codes")
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
  VIEWER
}

enum RefundStatus {
  PENDING
  FISCAL_SUBMITTING
  COMPLETED
  FISCAL_FAILED
  CANCELLED
}

enum SaleStatus {
  PENDING
  FISCAL_SUBMITTING
  COMPLETED
  FISCAL_FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  DIGITAL_WALLET
  BANK_TRANSFER
}

enum BatchStatus {
  ACTIVE
  EXPIRED
  DAMAGED
  SOLD_OUT
  RECALLED
}

enum InvoiceStatus {
  PENDING
  SUBMITTED
  ACCEPTED
  REJECTED
  FAILED
}

enum StockAdjustmentType {
  INCREASE
  DECREASE
  RECOUNT
  DAMAGED
  EXPIRED
}

enum ZraRegistrationStatus {
  PENDING
  REGISTERED
  FAILED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
  PAID_OUT
}

enum StockMovementType {
  PURCHASE_IN       // Stock received from supplier
  SALE_OUT          // Stock sold to customer
  ADJUSTMENT_IN     // Manual increase (found stock, correction)
  ADJUSTMENT_OUT    // Manual decrease (damage, theft, correction)
  TRANSFER_IN       // Stock received from another branch
  TRANSFER_OUT      // Stock sent to another branch
  RETURN_IN         // Customer returns
  RETURN_OUT        // Returns to supplier
  RECOUNT           // Physical stock count adjustment
  PRODUCTION_IN     // Manufactured/assembled items
  PRODUCTION_OUT    // Raw materials used in production
  // Item 28* (POST /stock/selectStockItems, OPTIONAL per spec). A record
  // retrieved FROM ZRA, not created by a local operational event — the
  // response has no direction/sarTyCd equivalent (confirmed against the
  // spec text; this endpoint's response fields don't include one), so
  // whether it represents an increase or decrease can't be safely
  // inferred. Stored as a reconciliation snapshot only; never applied to
  // Inventory.currentStock. See services/stockRetrieveSync.js.
  RECONCILED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SupplierReturnStatus {
  COMPLETED
  CANCELLED
}

model Customer {
  id            String    @id @default(cuid())
  name          String
  phone         String?
  email         String?
  tpin          String?
  address       String?
  notes         String?
  isActive      Boolean   @default(true)
  createdBy     String?
  updatedBy     String?
  deactivatedAt DateTime?
  deactivatedBy String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // VSDC branch-customer sync (Section 5.5, POST /branches/saveBrancheCustomers) —
  // only meaningful once `tpin` is set, since custTpin is a required field on
  // that endpoint; a walk-in customer with no tpin is never pushed.
  zraSyncedAt   DateTime?
  zraSyncError  String?
  zraSyncResponse Json?

  sales         Sale[]

  @@index([phone])
  @@index([tpin])
  @@index([name])
  @@map("customers")
}

model Supplier {
  id            String    @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  tpin          String?
  address       String?
  notes         String?
  isActive      Boolean   @default(true)
  createdBy     String?
  updatedBy     String?
  deactivatedAt DateTime?
  deactivatedBy String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  purchaseOrders     PurchaseOrder[]
  goodsReceivedNotes GoodsReceivedNote[]
  supplierReturns    SupplierReturn[]
  inventoryBatches   InventoryBatch[]

  @@index([name])
  @@map("suppliers")
}

// Non-fiscal business document — a request to buy stock from a Supplier.
// Receiving against it produces one or more GoodsReceivedNote records.
model PurchaseOrder {
  id           String              @id @default(cuid())
  poNumber     String              @unique
  supplierId   String
  branchId     String              @default("main")
  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  notes        String?
  subtotal     Float               @default(0)
  total        Float               @default(0)
  createdBy    String?
  updatedBy    String?
  cancelledAt  DateTime?
  cancelledBy  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  supplier           Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branch             Branch              @relation(fields: [branchId], references: [code])
  items              PurchaseOrderItem[]
  goodsReceivedNotes GoodsReceivedNote[]

  @@index([supplierId])
  @@index([branchId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String @id @default(cuid())
  purchaseOrderId  String
  productId        String
  quantityOrdered  Int
  quantityReceived Int    @default(0)
  unitCost         Float
  total            Float

  purchaseOrder PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product                 @relation(fields: [productId], references: [id])
  grnLines      GoodsReceivedNoteItem[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

// A physical delivery record — created only via PurchaseOrder receiving
// (routes/purchaseOrders.js POST /:id/receive), never directly.
model GoodsReceivedNote {
  id              String   @id @default(cuid())
  grnNumber       String   @unique
  purchaseOrderId String?
  supplierId      String
  branchId        String   @default("main")
  receivedDate    DateTime @default(now())
  notes           String?
  receivedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrder PurchaseOrder?          @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branch        Branch                  @relation(fields: [branchId], references: [code])
  items         GoodsReceivedNoteItem[]

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([branchId])
  @@map("goods_received_notes")
}

model GoodsReceivedNoteItem {
  id                  String  @id @default(cuid())
  goodsReceivedNoteId String
  purchaseOrderItemId String?
  productId           String
  quantityReceived    Int
  unitCost            Float
  batchId             String?

  goodsReceivedNote GoodsReceivedNote  @relation(fields: [goodsReceivedNoteId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])
  batch             InventoryBatch?    @relation(fields: [batchId], references: [id])

  @@index([goodsReceivedNoteId])
  @@index([purchaseOrderItemId])
  @@index([productId])
  @@index([batchId])
  @@map("goods_received_note_items")
}

// Stock sent back to a supplier — single-step, non-fiscal. Decrements stock
// via the same FIFO batch consumption sales use, writes a RETURN_OUT movement.
model SupplierReturn {
  id           String               @id @default(cuid())
  returnNumber String               @unique
  supplierId   String
  branchId     String               @default("main")
  status       SupplierReturnStatus @default(COMPLETED)
  reason       String?
  returnDate   DateTime             @default(now())
  subtotal     Float                @default(0)
  createdBy    String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  supplier Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branch   Branch               @relation(fields: [branchId], references: [code])
  items    SupplierReturnItem[]

  @@index([supplierId])
  @@index([branchId])
  @@map("supplier_returns")
}

model SupplierReturnItem {
  id               String  @id @default(cuid())
  supplierReturnId String
  productId        String
  batchId          String?
  quantity         Int
  unitCost         Float
  total            Float

  supplierReturn SupplierReturn  @relation(fields: [supplierReturnId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id])
  batch          InventoryBatch? @relation(fields: [batchId], references: [id])

  @@index([supplierReturnId])
  @@index([productId])
  @@index([batchId])
  @@map("supplier_return_items")
}
